# Copy to `backend/.env.test` (git-ignored) to run the live ADO functional
# tests. NEVER commit a real PAT. Rotate the token when you're done testing.
#
#   cp backend/.env.test.example backend/.env.test
#   # fill in ADO_PAT, then:  pytest -m functional

ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=your-personal-access-token

# Optional: pin the project / work-item type. If omitted, the tests use the
# first project and a sensible default type (Issue/Task/Bug/...).
# ADO_DEFAULT_PROJECT=dev-test
# ADO_TEST_WORK_ITEM_TYPE=Issue
