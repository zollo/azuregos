# ─────────────────────────────────────────────────────────────────────────
# Azuregos — TrueNAS environment. Copy to `.env` next to docker-compose.yml.
# Generate strong secrets:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# Where persistent Postgres data lives. MUST be a real dataset path on your
# pool — change 'tank' to your pool name. Create it first (see README).
AZUREGOS_DATA=/mnt/tank/apps/azuregos

# Host port to expose the web UI on (TrueNAS-friendly high port).
AZUREGOS_PORT=30080

# The URL users will use to reach Azuregos (used for SSO redirects / CORS).
AZUREGOS_PUBLIC_URL=http://truenas.local:30080

# Image tag to run (latest, a git sha, or a version tag).
AZUREGOS_TAG=latest

# --- Secrets ---
# Every secret is a plain env var. The stack boots with insecure placeholder
# defaults if these are blank, so CHANGE THEM before real use. You can set them
# here, in the shell, in Dockge, or in the TrueNAS Custom App env section.
SECRET_KEY=
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional overrides ---
POSTGRES_USER=azuregos
POSTGRES_DB=azuregos
BOOTSTRAP_ADMIN_EMAIL=admin@azuregos.local
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Azure DevOps (fill in to enable syncing) ---
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=
ADO_DEFAULT_PROJECT=YourProject
ADO_RETRY_INTERVAL_SECONDS=60
ADO_MAX_RETRY_ATTEMPTS=20

# --- Optional SSO ---
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=
SAML_ENABLED=false
SAML_METADATA_URL=
SAML_SP_ENTITY_ID=azuregos
SAML_ACS_URL=
