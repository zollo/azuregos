# ─────────────────────────────────────────────────────────────
# Azuregos environment configuration
# Copy to `.env` and fill in real values for local development.
# ─────────────────────────────────────────────────────────────

# --- Core ---
AZUREGOS_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins allowed by CORS (the frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database ---
POSTGRES_USER=azuregos
POSTGRES_PASSWORD=azuregos
POSTGRES_DB=azuregos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by config.py, override if needed:
# DATABASE_URL=postgresql+asyncpg://azuregos:azuregos@postgres:5432/azuregos

# --- Redis (Celery broker + result backend + sessions) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# --- Bootstrap admin (created on first startup if it does not exist) ---
BOOTSTRAP_ADMIN_EMAIL=admin@azuregos.local
BOOTSTRAP_ADMIN_PASSWORD=admin

# --- OAuth2 / OIDC (optional; leave blank to disable) ---
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback

# --- SAML (optional; leave blank to disable) ---
SAML_ENABLED=false
SAML_METADATA_URL=
SAML_SP_ENTITY_ID=azuregos
SAML_ACS_URL=http://localhost:8000/api/auth/saml/acs

# --- Azure DevOps ---
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PAT=your-personal-access-token
ADO_DEFAULT_PROJECT=YourProject
# How often (seconds) the worker retries pushing cached work items
ADO_RETRY_INTERVAL_SECONDS=60
ADO_MAX_RETRY_ATTEMPTS=20

# --- Frontend (baked at build time) ---
# Leave EMPTY for same-origin: the frontend nginx proxies /api to the backend,
# so the SPA uses relative URLs and works behind any host. Only set this to an
# absolute URL when the API is served from a different origin.
VITE_API_BASE_URL=
